{
  "name": "dukou-local-transfer",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "build": "bun build src/server.ts --target=bun --outdir dist",
    "compile": "bun build src/server.ts --compile --outfile dist/dukou",
    "compile:windows-x64": "bun build src/server.ts --compile --target=bun-windows-x64 --outfile dist/dukou-windows-x64.exe",
    "compile:macos-arm64": "bun build src/server.ts --compile --target=bun-darwin-arm64 --outfile dist/dukou-macos-arm64",
    "compile:macos-x64": "bun build src/server.ts --compile --target=bun-darwin-x64 --outfile dist/dukou-macos-x64",
    "compile:linux-x64": "bun build src/server.ts --compile --target=bun-linux-x64 --outfile dist/dukou-linux-x64"
  },
  "type": "module",
  "dependencies": {
    "tweetnacl": "1.0.3"
  }
}
